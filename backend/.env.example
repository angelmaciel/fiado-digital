# =============================================================================
# Fiado Digital — backend
# Copiá este archivo a `.env` y completá los valores reales.
# `.env` está en .gitignore: NUNCA lo subas al repo.
# =============================================================================

# --- Servidor ----------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Orígenes permitidos por CORS, separados por coma (sin espacios).
# En dev, el puerto de Flutter Web cambia en cada `flutter run -d chrome`
# salvo que lo fijes con --web-port=5000.
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# --- Base de datos (Neon) ----------------------------------------------------
# Connection string del pooler de Neon (termina en -pooler.<region>.aws.neon.tech).
# Formato: postgresql://<usuario>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://USUARIO:PASSWORD@ep-XXXX-pooler.sa-east-1.aws.neon.tech/fiado_digital?sslmode=require"

# Conexión directa (mismo host SIN el sufijo -pooler). Prisma la usa para
# ejecutar migraciones; el pooler de Neon no las soporta.
DIRECT_URL="postgresql://USUARIO:PASSWORD@ep-XXXX.sa-east-1.aws.neon.tech/fiado_digital?sslmode=require"

# --- JWT (RS256) -------------------------------------------------------------
# Par de claves RSA en PEM, codificadas en base64 para que entren en una sola
# línea del .env. Generalas con:  npm run keys:generate
JWT_PRIVATE_KEY_BASE64=PEGAR_AQUI_LA_CLAVE_PRIVADA_EN_BASE64
JWT_PUBLIC_KEY_BASE64=PEGAR_AQUI_LA_CLAVE_PUBLICA_EN_BASE64

JWT_ISSUER=fiado-digital
JWT_AUDIENCE=fiado-digital-app
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- Google OAuth 2.0 --------------------------------------------------------
# Client ID del cliente **Web** de Google Cloud Console. El backend lo usa para
# verificar los id_token que le manda la app.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# URI de callback del flujo de redirección (usado por Flutter Windows).
# Tiene que estar registrada igual en Google Cloud Console.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Client IDs adicionales que también se aceptan al verificar id_token, separados
# por coma. Android y iOS emiten tokens con SU propio client_id como audience.
# Dejalo vacío si solo vas a usar el cliente Web.
GOOGLE_ADDITIONAL_CLIENT_IDS=

# A dónde redirige el backend después del callback de Google.
#
# Este flujo lo usa SOLO la app de escritorio (Windows), porque google_sign_in
# no soporta esa plataforma. La app levanta un servidor loopback en el puerto
# 8765 y espera ahí los tokens, así que este puerto tiene que coincidir con
# `kPuertoCallbackEscritorio` en app/lib/src/features/auth/data/google_auth_service.dart
#
# Android y Web no pasan por acá: usan POST /api/auth/google con el id_token.
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:8765/auth/callback

# --- Envío de correo ----------------------------------------------------
# consola = imprime el código de verificación en el log (default, sin setup)
# smtp    = lo manda de verdad
EMAIL_PROVIDER=consola

# Solo hacen falta con EMAIL_PROVIDER=smtp.
#
# En desarrollo, Gmail: activá la verificación en dos pasos y creá una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords. La
# contraseña normal de la cuenta NO funciona.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#
# EN PRODUCCIÓN (Render) ESTO NO SIRVE. El plan gratuito bloquea el tráfico
# SMTP saliente por los puertos clásicos —25, 465 y 587—, y el síntoma engaña:
# no es un rechazo de credenciales sino `Connection timeout`, porque el paquete
# nunca sale del servidor.
#
# La salida que funciona es un proveedor que ofrezca SMTP por el puerto 2525,
# que sí pasa. Brevo (ex Sendinblue) da 300 correos por día gratis:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=2525
#   SMTP_USER=xxxxxx@smtp-brevo.com   <- el "Login" que muestra su panel,
#                                        NO tu correo
#   SMTP_PASSWORD=<la SMTP key que se genera en Settings -> SMTP & API>
#
# Y hay que dar de alta EMAIL_REMITENTE como remitente verificado en el panel
# del proveedor: si no coincide exactamente, rechaza el envío.
#
# Mailtrap (para probar sin mandar nada de verdad):
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_REMITENTE=Fiado Digital <tucorreo@gmail.com>
