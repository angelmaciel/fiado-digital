# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/android/.gradle/
app/android/local.properties
app/windows/flutter/ephemeral/
# Los archivos generados por drift SI se versionan. Regenerarlos en CI cuesta
# unos 3 minutos por push (build_runner compila sus builders desde cero), y
# tenerlos en el repo garantiza que la CI compile exactamente lo mismo que se
# verifico localmente.
app/**/*.freezed.dart

